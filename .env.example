# Copy to .env for LOCAL runs (python / docker compose). On Render you set these
# as environment variables in the dashboard instead (see render.yaml) — .env is
# never uploaded. Never commit or paste .env. Do not wrap values in quotes.

GROQ_API_KEY=your-groq-api-key-here

# Chat models (full LiteLLM strings). Groq's catalogue changes — see https://console.groq.com/docs/models
# LLM_MODEL_NAME=groq/openai/gpt-oss-20b
# FALLBACK_MODEL_NAME=groq/openai/gpt-oss-120b
# JUDGE_MODEL_NAME=openai/gpt-oss-120b

# ── Retrieval backend ──────────────────────────────────────────────────────
# LOCAL run (default): embeddings + reranker run on your CPU, Qdrant is a folder.
#   EMBEDDING_PROVIDER=local
#   RERANK_PROVIDER=local
# RENDER free plan (512 MB RAM, no persistent disk): use APIs + hosted Qdrant.
#   Use the SAME settings for the one-time `python ingest.py` you run from your
#   laptop, otherwise the vectors Render queries won't match how they were built.
# EMBEDDING_PROVIDER=jina
# RERANK_PROVIDER=jina
# JINA_API_KEY=your-jina-key              # free starting tokens, non-commercial
# QDRANT_URL=https://your-cluster-url.qdrant.io     # free 1 GB cluster at cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key-here

# ── Access control (Google login) ──────────────────────────────────────────
# Comma-separated emails allowed past the login. Only enforced when the
# [auth] secrets exist (.streamlit/secrets.toml locally, Secret File on Render).
# ALLOWED_EMPLOYEE_EMAILS=alice@company.com,bob@company.com
# REQUIRE_AUTH=false                      # render.yaml sets this to true

# ── Safety + tuning ────────────────────────────────────────────────────────
# GUARDRAIL_PROVIDER=llm                  # llm | none
# RELEVANCE_THRESHOLD=0.35
# SEMANTIC_CACHE_THRESHOLD=0.93

# ── LangSmith (optional, free developer plan) ──────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=hr-policy-assistant
