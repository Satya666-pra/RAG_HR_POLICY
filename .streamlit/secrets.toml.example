# Streamlit's built-in Google login. Copy to .streamlit/secrets.toml to test
# locally; on Render, paste the same content into a Secret File named
# "secrets.toml" (Dashboard -> your service -> Environment -> Secret Files).
# NEVER commit the real file (it is in .gitignore / .dockerignore).
#
# Layout matters: app.py calls st.login("google"), a NAMED provider, so the
# Google credentials must live under [auth.google]. Only redirect_uri and
# cookie_secret go directly under [auth].
#
# Get client_id / client_secret from Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth client ID (type: Web application). Creating an OAuth
# client does not require a paid plan. Add the redirect URI below to the client's
# "Authorized redirect URIs". While the consent screen is in "Testing" mode, also
# add each employee email as a Test user.

[auth]
# local test:   http://localhost:8501/oauth2callback
# on Render:    https://<your-service>.onrender.com/oauth2callback
redirect_uri = "https://YOUR-SERVICE.onrender.com/oauth2callback"
cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-STRING"   # python -c "import secrets; print(secrets.token_hex(32))"

[auth.google]
client_id = "REPLACE.apps.googleusercontent.com"
client_secret = "REPLACE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
